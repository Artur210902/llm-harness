# Any OpenAI-compatible Chat Completions endpoint. Leave the key empty to use the offline scripted model.
HARNESS_API_KEY=
HARNESS_MODEL=
# HARNESS_BASE_URL is optional (defaults to api.openai.com). Examples:
#   Anthropic:  HARNESS_BASE_URL=https://api.anthropic.com/v1/   HARNESS_MODEL=claude-sonnet-5
#   OpenRouter: HARNESS_BASE_URL=https://openrouter.ai/api/v1    HARNESS_MODEL=<provider>/<model>
#   Ollama:     HARNESS_BASE_URL=http://localhost:11434/v1       HARNESS_MODEL=qwen2.5-coder:14b  (any key)
HARNESS_BASE_URL=
# Set to false for self-hosted endpoints with a self-signed TLS certificate
HARNESS_SSL_VERIFY=true
HARNESS_TEMPERATURE=0.2
HARNESS_MAX_REVISIONS=2
HARNESS_SANDBOX_TIMEOUT=60
